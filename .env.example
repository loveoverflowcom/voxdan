# Proposed configuration names for the future server; not consumed by this bootstrap.
# Copy to .env only after the corresponding runtime configuration is implemented.
# Development examples only. Supply actual secrets through the deployment secret store.
CANTOS_ENV=development
CANTOS_BIND_ADDRESS=127.0.0.1:8080
DATABASE_URL=postgresql://cantos:development_only@localhost:5432/cantos
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_PRIVATE_BUCKET=cantos-private
S3_PUBLICATION_BUCKET=cantos-publications
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
TTS_PROVIDER=
TTS_API_KEY=
AI_ADAPTATION_PROVIDER=
AI_ADAPTATION_API_KEY=
# Maximum reserved/actual production cost must be explicitly configured before paid calls.
PRODUCTION_COST_LIMIT_MINOR=
PRODUCTION_COST_CURRENCY=
